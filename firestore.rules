rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ──────────────────────────────────────────────────────────────────────
    // Shared helpers. Every @activeset.co identity is "the team"; admins are
    // the two hardcoded emails or anyone carrying the `admin` custom claim
    // (the local-dev token endpoint stamps it). Mirrors src/lib/api-auth.ts.
    // ──────────────────────────────────────────────────────────────────────
    function isAdmin() {
      return request.auth != null
        && (request.auth.token.email == 'rehan@activeset.co'
            || request.auth.token.email == 'salman@activeset.co'
            || request.auth.token.admin == true);
    }

    function isActiveSetUser() {
      return request.auth != null
        && request.auth.token.email is string
        && request.auth.token.email.matches('.*@activeset\\.co$');
    }

    // ──────────────────────────────────────────────────────────────────────
    // Server-only collections. Deny everything to client SDKs; reads and
    // writes go through firebase-admin in route handlers. Collections that
    // are NOT listed anywhere in this file are also denied by default —
    // client_portal_tokens, projects/{id}/portal_views, extension_tokens,
    // project_invoices and app_secrets rely on that.
    // ──────────────────────────────────────────────────────────────────────
    match /project_secrets/{projectId} {
      allow read, write: if false;
    }

    // ──────────────────────────────────────────────────────────────────────
    // projects — never publicly readable. Public widget data must go through
    // /api/project/{id}, which allow-lists fields with firebase-admin. Writes
    // reject any webflowConfig payload that includes apiToken, so the migrated
    // secret can never be re-introduced on the client-readable doc.
    // ──────────────────────────────────────────────────────────────────────
    match /projects/{projectId} {
      function isOwner() {
        return request.auth != null
          && resource.data.userId == request.auth.uid;
      }

      function isNewOwner() {
        return request.auth != null
          && request.resource.data.userId == request.auth.uid;
      }

      function isProjectOwnerById() {
        return request.auth != null
          && get(/databases/$(database)/documents/projects/$(projectId)).data.userId == request.auth.uid;
      }

      function canAccessProject() {
        return isAdmin() || isOwner() || isActiveSetUser();
      }

      function canAccessProjectById() {
        return isAdmin() || isProjectOwnerById() || isActiveSetUser();
      }

      function writeHasNoApiToken() {
        return !('webflowConfig' in request.resource.data)
          || request.resource.data.webflowConfig == null
          || !('apiToken' in request.resource.data.webflowConfig);
      }

      allow read: if canAccessProject();
      allow create: if (isAdmin() || isNewOwner() || isActiveSetUser()) && writeHasNoApiToken();
      allow update: if canAccessProject()
        && request.resource.data.userId == resource.data.userId
        && writeHasNoApiToken();
      allow delete: if canAccessProject();

      match /link_audits/{linkId} {
        allow read, write: if canAccessProjectById();
      }

      // ────────────────────────────────────────────────────────────────────
      // Client conversation. Team-only from the browser; the client's own
      // messages are written by /api/portal/[token]/messages with
      // firebase-admin, which bypasses these rules. Rules do NOT cascade into
      // subcollections, so anything not matched here (portal_views) stays
      // deny-by-default even though the parent project is team-readable.
      // ────────────────────────────────────────────────────────────────────
      // Delivery: one document per page being built. Team-only, like the rest of
      // the project's working data. Clients never read this directly — page
      // progress reaches them as a count through the portal projection, and in
      // full through the generated tracker sheet.
      match /pages/{pageId} {
        allow read, write: if isActiveSetUser();
      }

      match /client_updates/{updateId} {
        allow read, write: if isActiveSetUser();
      }

      match /client_messages/{messageId} {
        // Reading and triaging is a team action. Clients never read this back;
        // their own message is echoed to them by the portal projection.
        allow read, update, delete: if isActiveSetUser();
        allow create: if false;
      }
    }

    // ──────────────────────────────────────────────────────────────────────
    // Per-project work data. Reads stay open because the public audit share
    // (/share/project-links/[token]) still renders these from the browser;
    // writes are team-only. No server route writes these with the client SDK
    // (ClickUp webhooks, nag-bot and Raycast all use firebase-admin).
    // ──────────────────────────────────────────────────────────────────────
    match /project_timelines/{id} {
      allow read: if true;
      allow write: if isActiveSetUser();
    }
    match /project_checklists/{id} {
      allow read: if true;
      allow write: if isActiveSetUser();
    }
    match /tasks/{id} {
      allow read: if true;
      allow write: if isActiveSetUser();
    }
    match /requests/{id} {
      allow read: if true;
      allow write: if isActiveSetUser();
    }

    // Module access grants: everyone signed in reads them (the nav resolves
    // grants client-side); only admins may change them. Settings → Team Access
    // is admin-only UI and AccessControlService seeds the doc only as an admin.
    match /access_control/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Everything below stays on prior permissive behavior. We list each
    // collection explicitly rather than using `match /{document=**}` so
    // the server-only and default-deny collections actually take effect.
    match /timeline_templates/{id}         { allow read, write: if true; }
    match /sop_templates/{id}             { allow read, write: if true; }
    match /scan_jobs/{id}                 { allow read, write: if true; }
    match /site_alerts/{id}               { allow read, write: if true; }
    match /health_reports/{id}            { allow read, write: if true; }
    match /scan_notifications/{id}        { allow read, write: if true; }
    match /audit_logs/{id}                { allow read, write: if true; }
    match /content_changes/{id}           { allow read, write: if true; }
    match /schema_analyses/{id}           { allow read, write: if true; }
    match /cmsRuns/{runId}                { allow read, write: if true; }
    match /cmsRuns/{runId}/events/{eid}   { allow read, write: if true; }
    match /schemaRuns/{runId}             { allow read, write: if true; }
    match /schemaRuns/{runId}/events/{eid}{ allow read, write: if true; }
    match /configurations/{id}            { allow read, write: if true; }
    match /webflow_account_history/{id}   { allow read, write: if true; }

    // Proposals - team only (contains pricing/internal notes)
    match /proposals/{proposalId} {
      allow read, write: if isActiveSetUser();
    }

    // Shared Proposals - public read for client-facing share URLs. Client
    // signatures are written by /api/proposals/[id]/sign with firebase-admin;
    // the agency's own writes come from signed-in team members.
    match /shared_proposals/{proposalId} {
      allow read: if true;
      allow write: if isActiveSetUser();
    }

    // Proposal Templates - team only
    match /templates/{templateId} {
      allow read, write: if isActiveSetUser();
    }

    // Proposal Views - server-only. /api/proposals/[id]/view writes through
    // firebase-admin; agency dashboard reads the aggregate counters off the
    // proposal doc, not this collection. Deny direct client access.
    match /proposal_views/{viewId} {
      allow read, write: if false;
    }

    // Proposal Comments - public read on shared proposals; clients may leave a
    // comment from the public view (authorType 'client'), the team does the rest.
    match /proposal_comments/{commentId} {
      allow read: if true;
      allow create: if isActiveSetUser() || request.resource.data.authorType == 'client';
      allow update, delete: if isActiveSetUser();
    }

    // Proposal History - team only, except the public e-signature flow may
    // append a 'signed' event.
    match /proposal_history/{historyId} {
      allow read: if isActiveSetUser();
      allow create: if isActiveSetUser() || request.resource.data.changeType == 'signed';
      allow update, delete: if isActiveSetUser();
    }

    // Webflow Sessions - allow public access for extension communication
    match /webflow_sessions/{sessionId} {
      allow read, write: if true;
    }

    // Webflow Pings - teammate-to-teammate "are you still using this?" pings
    match /webflow_pings/{pingId} {
      allow read, write: if true;
    }
  }
}
